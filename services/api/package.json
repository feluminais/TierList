  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
